---
// Shared page layout. Loads nothing from third parties.
import ThemeSwitch from "#/components/ThemeSwitch.svelte";
import "#/styles/global.css";

// bodyClass replaces the default background, e.g. /today's darker fill.
const { title, description, bodyClass = "bg-fill-1" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <!-- Sets the theme before first paint to avoid a flash. Duplicates
         autoTheme() in lib/theme-switch.ts (inline scripts can't import). -->
    <script is:inline>
      const saved = localStorage.getItem("theme");
      const h = new Date().getHours();
      document.documentElement.dataset.theme =
        saved === "light" || saved === "dark" ? saved : h >= 6 && h < 18 ? "light" : "dark";
    </script>
  </head>
  <body class:list={["font-ui fs-16 leading-body text-fg", bodyClass]}>
    <main class="mx-auto max-w-column px-5 pt-8 pb-12 max-wide:pt-16">
      <slot />
      {/* Kept on one line: wrapping would put spaces inside the link. */}
      <!-- prettier-ignore -->
      <footer class="mt-12 text-center fs-13 text-fg-subtle">
        with love and support from <a class="text-fg-muted underline" href="https://x.com/_afsheen_a" target="_blank">afsheen</a> ♥
      </footer>
    </main>

    <ThemeSwitch />
    <script>
      import { initThemeSwitch } from "#/lib/theme-switch.ts";
      initThemeSwitch(document.getElementById("theme")!);
    </script>
  </body>
</html>
