---
// Shared page layout. Loads nothing from third parties.
import ThemeSwitch from "../components/ThemeSwitch.svelte";
import "../styles/tailwind.css";

const { title, description, bodyClass } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <!-- Sets the theme before first paint to avoid a flash. Duplicates
         autoTheme() in lib/theme.ts (inline scripts can't import). -->
    <script is:inline>
      const saved = localStorage.getItem("theme");
      const h = new Date().getHours();
      document.documentElement.dataset.theme =
        saved === "light" || saved === "dark" ? saved : h >= 6 && h < 18 ? "light" : "dark";
    </script>
  </head>
  <body class={bodyClass}>
    <main>
      <slot />
      <footer>
        with love and support from <a href="https://x.com/_afsheen_a" target="_blank">afsheen</a> ♥
      </footer>
    </main>

    <ThemeSwitch />
    <script>
      import { initThemeSwitch } from "../lib/theme.ts";
      initThemeSwitch(document.getElementById("theme")!);
    </script>
  </body>
</html>
