---
// The shell every page sits in. Styles are inlined by the build, so a
// page is one request; nothing here reaches a third party.
import ThemeSwitch from "../components/ThemeSwitch.svelte";
import "../styles/tailwind.css";

const { title, description, bodyClass } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <!-- Auto follows the local clock (6am–6pm is light, else dark); a saved
         choice or the auto read has to land before first paint or the page
         flashes the wrong ground (O6). lib/theme.ts's autoTheme() is the
         same 6/18 split — kept in sync there; this copy can't import. -->
    <script is:inline>
      var t = localStorage.getItem("theme");
      if (t !== "light" && t !== "dark") {
        var h = new Date().getHours();
        t = (h >= 6 && h < 18) ? "light" : "dark";
      }
      document.documentElement.dataset.theme = t;
    </script>
  </head>
  <body class={bodyClass}>
    <main>
      <slot />
      <footer>
        with love and support from <a href="https://x.com/_afsheen_a" target="_blank">afsheen</a> ♥
      </footer>
    </main>

    <ThemeSwitch />
    <script>
      import { initThemeSwitch } from "../lib/theme.ts";
      initThemeSwitch(document.getElementById("theme")!);
    </script>
  </body>
</html>
