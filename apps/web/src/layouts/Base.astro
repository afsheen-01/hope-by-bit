---
// The layout every page shares: head, main column, footer and theme switch.
// Nothing here loads from a third-party server.
import ThemeSwitch from "../components/ThemeSwitch.svelte";
import "../styles/tailwind.css";

const { title, description, bodyClass } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <!-- Picks the theme before the page first paints, so it never flashes the
         wrong colours: the saved choice if there is one, otherwise light from
         6am to 6pm and dark the rest of the time. This repeats autoTheme() in
         lib/theme.ts (keep the two in sync), because an inline script that
         must run this early can't import a module. -->
    <script is:inline>
      const saved = localStorage.getItem("theme");
      const h = new Date().getHours();
      document.documentElement.dataset.theme =
        saved === "light" || saved === "dark" ? saved : h >= 6 && h < 18 ? "light" : "dark";
    </script>
  </head>
  <body class={bodyClass}>
    <main>
      <slot />
      <footer>
        with love and support from <a href="https://x.com/_afsheen_a" target="_blank">afsheen</a> ♥
      </footer>
    </main>

    <ThemeSwitch />
    <script>
      import { initThemeSwitch } from "../lib/theme.ts";
      initThemeSwitch(document.getElementById("theme")!);
    </script>
  </body>
</html>
