---
// Today's story, readable without JavaScript.
import BaseLayout from "#/layouts/BaseLayout.astro";
import MovementList from "#/components/story/MovementList.svelte";
import Story from "#/components/story/Story.svelte";
import { today } from "#/lib/story.ts";

const bit = today();
---

<BaseLayout title="Hope By Bit — today's story" bodyClass="bg-fill-1 antialiased">
  <Story bit={bit}>
    <MovementList items={bit.movements} />
  </Story>
</BaseLayout>

<script>
  import { initMovements } from "#/lib/movement-list.ts";

  initMovements(document.getElementById("movements")!);
</script>
