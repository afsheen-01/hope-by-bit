---
// Today's story, readable without JavaScript. On a first visit the script
// below loads onboarding over it.
import BaseLayout from "#/layouts/BaseLayout.astro";
import MovementList from "#/components/story/MovementList.svelte";
import Story from "#/components/story/Story.svelte";
import { today } from "#/lib/story.ts";

const bit = today();
---

<BaseLayout title="Hope By Bit — today's story" bodyClass="bg-fill-3 antialiased">
  <Story bit={bit}>
    <MovementList items={bit.movements} />
  </Story>
</BaseLayout>

<script>
  import { initMovements } from "#/lib/movement-list.ts";
  import { shouldOnboard } from "#/lib/onboarding/gate.ts";

  initMovements(document.getElementById("movements")!);

  if (shouldOnboard()) {
    import("#/lib/onboarding/mount.ts").then(({ mountOnboarding }) =>
      mountOnboarding(document.querySelector("main")!),
    );
  }
</script>
