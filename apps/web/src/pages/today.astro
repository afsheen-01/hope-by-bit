---
// Today's story. On a first visit, onboarding opens over it; once that's
// done (or on any later visit) the story is all there is.
//
// Everything renders at build time, so the story reads with JavaScript off.
// The script below adds the movement toggle and, on a first visit only,
// fetches onboarding — the one part that needs Svelte in the browser.
import Base from "../layouts/Base.astro";
import Movements from "../components/story/Movements.svelte";
import Story from "../components/story/Story.svelte";
import { today } from "../lib/today.ts";

const bit = today();
---

<Base title="Hope By Bit — today's story" bodyClass="screen-page">
  <Story bit={bit}>
    <Movements items={bit.movements} />
  </Story>
</Base>

<script>
  import { initMovements } from "../lib/movements.ts";
  import { shouldOnboard } from "../lib/onboarding/gate.ts";

  initMovements(document.querySelector<HTMLElement>(".movements")!);

  if (shouldOnboard()) {
    import("../lib/onboarding/mount.ts").then(({ mountOnboarding }) =>
      mountOnboarding(document.querySelector("main")!),
    );
  }
</script>
