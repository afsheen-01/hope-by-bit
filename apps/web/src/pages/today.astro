---
// The daily unit in a browser (techSpec/web/ui.md's /today) — headline,
// figure, body, source, the day's movements. A first visit runs onboarding
// first (O7); the story underneath is what onboarding hands off to, and
// what anyone returning sees straight away.
import Base from "../layouts/Base.astro";
import { placeholder, today } from "../lib/today.ts";
import "../styles/screen.css";
import "../styles/onboarding.css";
import "../styles/onboarding-page.css";
import "../styles/tailwind.css";

const bit = today();
---

<Base title="Hope By Bit — today's story">
  <!-- .bit scopes the story's styles above screen.css, which ships on this
       page for the onboarding overlay's primitives and shares class names
       (.figure, .date, .ask…) with the site's own. -->
  <article class="bit">
    <p class="date">{bit.date}</p>
    <h1>{bit.headline}</h1>

    <p class="figure">
      <span class="figure-num">{bit.figure}</span>
      <span class="figure-cap">{bit.figureCap}</span>
    </p>

    <p class="body">{bit.body}</p>
    <p class="source">{bit.source}</p>

    <section class="action">
      <h2>One small thing</h2>
      <p class="ask">{bit.ask}</p>
      <ul class="movements">
        {bit.movements.map((m, i) => (
          <li>
            <button type="button" data-choice={i} aria-pressed="false">{m}</button>
          </li>
        ))}
      </ul>
    </section>

    {bit === placeholder && (
      <p class="note">
        Example story: nothing has been published here yet. The nightly pipeline fills this in.
      </p>
    )}
  </article>

  <!-- W2 · the story above came from the last nightly build, so a tab left
       open overnight is showing yesterday's. Fetch today's and swap only if
       the date has moved — which is also how a correction to a published
       story reaches a reader the same morning rather than at the next build.
       Same-origin `/api`, so the no-third-party-request rule still holds. -->
  <script is:inline>
    fetch("/api/bits/today")
      .then((r) => (r.ok ? r.json() : null))
      .then((bit) => {
        const article = document.querySelector(".bit");
        if (!bit || !article || bit.date === article.querySelector(".date")?.textContent) return;
        const put = (sel, text) => {
          const el = article.querySelector(sel);
          if (el) el.textContent = text;
        };
        put(".date", bit.date);
        put("h1", bit.headline);
        put(".figure-num", bit.figure);
        put(".figure-cap", bit.figureCap);
        put(".body", bit.body);
        put(".source", bit.source);
        put(".ask", bit.ask);
        // Rebuild the buttons rather than relabel them: a movement someone
        // already ticked is not the same movement once the day has changed.
        const list = article.querySelector(".movements");
        if (list) {
          list.innerHTML = "";
          bit.movements.forEach((m, i) => {
            const li = document.createElement("li");
            const b = document.createElement("button");
            b.type = "button";
            b.dataset.choice = String(i);
            b.setAttribute("aria-pressed", "false");
            b.textContent = m;
            li.append(b);
            list.append(li);
          });
        }
        article.querySelector(".note")?.remove();
      })
      // Offline is a normal state here: the story on the page is already
      // today's as far as this device knows, and it stays readable.
      .catch(() => {});
  </script>

  <!-- Done, and still tappable: a mistap undoes as easily as it happened.
       Deliberately not persisted — the wall's cumulative total is the only
       number this product keeps (P2); a per-day record is a streak. -->
  <script is:inline>
    document.querySelector(".movements")?.addEventListener("click", (e) => {
      const b = e.target.closest("[data-choice]");
      if (!b) return;
      const done = b.getAttribute("aria-pressed") !== "true";
      b.setAttribute("aria-pressed", String(done));
      b.querySelector(".tick")?.remove();
      if (done) b.insertAdjacentHTML("afterbegin", '<span class="tick" aria-hidden="true">✓</span>');
    });
  </script>

  <!-- Empty without JavaScript, and the story above is already the whole
       page — so a first visit with JS off gets today's story rather than
       a flow it can't run (the read-with-JS-off rule in techSpec/web/ui.md). -->
  <div id="onboarding"></div>
  <script src="../scripts/mount-onboarding.js"></script>
</Base>
