{
  "name": "@hope/web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "pnpm verify && astro dev",
    "build": "pnpm verify && astro build",
    "preview": "astro preview",
    "verify": "pnpm format:check && pnpm lint && pnpm check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test --experimental-strip-types"
  },
  "dependencies": {
    "@astrojs/svelte": "^7.2.5",
    "@phosphor-icons/core": "^2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@zag-js/core": "^1.43.0",
    "@zag-js/number-input": "^1.43.0",
    "@zag-js/vanilla": "^1.43.0",
    "astro": "^5.13.0",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
