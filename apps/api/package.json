{
  "name": "@hope/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "docker compose up -d && npm run migrate && node --watch --experimental-strip-types --env-file-if-exists=.env src/index.ts",
    "start": "node --experimental-strip-types --env-file-if-exists=.env src/index.ts",
    "migrate": "node --experimental-strip-types --env-file-if-exists=.env src/migrate.ts",
    "pipeline": "node --experimental-strip-types --env-file-if-exists=.env src/pipeline/run.ts",
    "review": "node --experimental-strip-types src/pipeline/review.ts",
    "test": "node --test --experimental-strip-types",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.9.0",
    "postgres": "^3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.9"
  }
}
