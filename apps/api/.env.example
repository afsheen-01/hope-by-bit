# Stories and config must work with none of this set — signed out is the whole
# product minus a second device, and a self-hoster shouldn't need a Google
# client to read today's story (backend.md).

# Accounts and sync (B3, B4). docker-compose.yml brings this up locally.
# Already running Postgres on 5432? Set DB_PORT=5433 and use it below too.
DB_PORT=5432
DATABASE_URL=postgres://hope:hope@localhost:5432/hope

# Sign-in (B3). Without GOOGLE_*, POST /auth/google returns 501.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign-in links (B3). Without it the link is written to stdout instead of
# posted — which is what self-hosting needs anyway.
RESEND_API_KEY=
MAIL_FROM=Hope By Bit <hello@localhost>

# The pipeline's classifier (B1). Without it, only recorded fixtures run.
ANTHROPIC_API_KEY=

# Where the browser reaches us. Sign-in links and the OAuth redirect use it.
PUBLIC_ORIGIN=http://localhost:4321
PORT=8787
